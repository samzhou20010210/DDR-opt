Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Offset: {X: 12.5, Y: 6.25, Z: -0.02}
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz/MarkerArray
      Name: Pool
      Enabled: true
      Marker Topic: /pool/env/markers
      Queue Size: 100
    - Class: rviz/Path
      Name: Trajectory
      Enabled: true
      Topic: /pool/robot/trajectory
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.04
      Alpha: 1
    - Class: rviz/MarkerArray
      Name: Hull
      Enabled: true
      Marker Topic: /pool/robot/hull_markers
      Queue Size: 100
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Marker Scale: 1
      Show Arrows: false
      Show Axes: true
      Show Names: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      X: 12.5
      Y: 6.25
      Angle: 0
      Scale: 45
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1400
  X: 60
  Y: 60
  Displays:
    collapsed: false
