<launch>
  <!-- Pool rescue simulation. All pool/vessel/mode values come from config/pool_rescue.yaml via the
       generated per-node files (scripts/gen_ddr_params.py). The stock example
       (plan_manager/launch/planner_sim.launch) is untouched. -->

  <arg name="mode" default="approach"/>   <!-- approach | rescue : selects config/generated/<mode>/ -->
  <arg name="gui" default="true"/>        <!-- false = headless (no rviz) -->
  <arg name="check" default="true"/>      <!-- run the live parameter / TF / interface check once at startup -->

  <arg name="gen" value="$(find pool_rescue)/config/generated/$(arg mode)"/>
  <arg name="odom_topic" value="/ICREKF/EKF_XYTheta"/>     <!-- legacy EKF output, consumed by planner + MPC -->
  <arg name="traj_topic" value="/planner/traj_poly"/>

  <!-- Central parameters for new (non-legacy) nodes: /pool/<group>/<name>/{value,unit,source} -->
  <rosparam file="$(find pool_rescue)/config/pool_rescue.yaml" command="load" ns="pool"/>
  <param name="/pool/mode" value="$(arg mode)"/>

  <!-- ======================= legacy DDR-opt nodes (unchanged code) ======================= -->
  <!-- Load order inside each node: stock tuning first, generated pool values last (they win). -->

  <node name="global_planning" pkg="plan_manager" type="global_planning" output="screen">
    <rosparam file="$(find front_end)/config/jps3ms.yaml" command="load"/>
    <rosparam file="$(find back_end)/config/global_planning3ms.yaml" command="load"/>
    <rosparam file="$(find plan_env)/config/mapsim.yaml" command="load"/>
    <rosparam file="$(arg gen)/global_planning.yaml" command="load"/>
    <remap from="~local_pointcloud" to="/laser_simulator/local_pointcloud"/>
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~traj" to="$(arg traj_topic)"/>
  </node>

  <node name="simulator" pkg="simulator" type="simulator" output="screen">
    <rosparam file="$(arg gen)/simulator.yaml" command="load"/>
  </node>

  <!-- MUST be named "mpc": mpc_controller reads only the absolute namespace /mpc/... -->
  <node name="mpc" pkg="mpc_controller" type="mpc" output="screen">
    <rosparam file="$(find mpc_controller)/config/mpc3ms.yaml" command="load"/>
    <rosparam file="$(arg gen)/mpc.yaml" command="load"/>
    <remap from="~cmd" to="/pool/internal/mpc_cmd"/>    <!-- goes through ddr_adapter, not straight to the sim -->
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~traj" to="$(arg traj_topic)"/>
  </node>

  <node name="global_map_node" pkg="simulator" type="global_map_node" output="screen">
    <rosparam file="$(arg gen)/global_map_node.yaml" command="load"/>
  </node>

  <node name="laser_simulator" pkg="laser_simulator" type="laser_sim_node" output="screen">
    <rosparam file="$(find laser_simulator)/config/perspective_laser.yaml" command="load"/>
    <rosparam file="$(arg gen)/laser_simulator.yaml" command="load"/>
  </node>

  <node name="icrekf" pkg="icrekf" type="icrekf" output="screen">
    <!-- stock EKF tuning (planner_sim.launch) -->
    <param name="Pose_sub_Reduce_frequency_" value="0"/>
    <param name="state_pub_frequency" value="100.0"/>
    <param name="Q_x" value="0.5"/>  <param name="Q_y" value="0.5"/>  <param name="Q_psi" value="1.14"/>
    <param name="Q_yr" value="0.1"/> <param name="Q_yl" value="0.1"/> <param name="Q_xv" value="0.1"/>
    <param name="R_x" value="0.1"/>  <param name="R_y" value="0.1"/>  <param name="R_psi" value="0.1"/>
    <rosparam file="$(arg gen)/icrekf.yaml" command="load"/>
    <remap from="ref_pose" to="/simulation/SimulatedCarState"/>
    <remap from="odom" to="/simulation/PoseOdomPub"/>
    <remap from="control" to="/simulation/ControlPub"/>
    <remap from="EKF_XYTheta" to="/ICREKF/EKF_XYTheta"/>
    <remap from="EKF_ICR" to="/ICREKF/EKF_ICR"/>
    <remap from="Simple_EKF_ICR" to="/ICREKF/Simple_EKF_ICR"/>
  </node>

  <!-- ======================= adaptation layer ======================= -->
  <node name="ddr_adapter" pkg="pool_rescue" type="ddr_adapter" output="screen">
    <rosparam file="$(arg gen)/ddr_adapter.yaml" command="load"/>
    <remap from="mpc_cmd" to="/pool/internal/mpc_cmd"/>
    <remap from="cmd_vel" to="/pool/cmd_vel"/>
    <remap from="sim_cmd" to="/simulation/PoseSub"/>
    <remap from="ekf_odom" to="$(arg odom_topic)"/>
    <remap from="truth" to="/simulation/PosePub"/>
    <remap from="odom" to="/pool/robot/odom"/>
    <remap from="odom_truth" to="/pool/robot/odom_truth"/>
  </node>

  <node if="$(arg check)" name="param_check" pkg="pool_rescue" type="check_params.py" output="screen"
        args="--live --mode $(arg mode)"/>

  <node if="$(arg gui)" name="rviz" pkg="rviz" type="rviz" args="-d $(find plan_manager)/rviz/planner_sim.rviz" output="log"/>
</launch>
