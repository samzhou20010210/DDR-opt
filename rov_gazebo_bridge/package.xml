<?xml version="1.0"?>
<package format="2">
  <name>rov_gazebo_bridge</name>
  <version>0.1.0</version>
  <description>Runs DDR-opt's planar holonomic ROV stack (robot:=rov_holo) on ROV_V4 in the uwv-simulator Gazebo pool:
    odometry in (pool-corner frame), thrust out (by thruster name), depth / attitude hold, pool obstacles.</description>
  <maintainer email="samzhou20010210@gmail.com">sam</maintainer>
  <license>GPLv3</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>carstatemsgs</exec_depend>
  <exec_depend>plan_manager</exec_depend>
  <exec_depend>holo_control</exec_depend>
  <exec_depend>laser_simulator</exec_depend>
  <exec_depend>uwv_description</exec_depend>
  <exec_depend>uwv_env</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
</package>
